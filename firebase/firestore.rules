rules_version = '2';

// Kapok Firestore security rules.
//
// Model:
// - A team's data (the team doc, its tasks, its members' profiles) is visible
//   only to that team's members/leader and to admins.
// - Joining requires the team's invite code. Codes are looked up through
//   /teamCodes/{code} (get-only, never listable), and the join write must
//   prove knowledge of the code via the joiner's users/{uid}.joinCode field
//   written in the same transaction.
// - Leader powers apply only to the team the user actually leads
//   (teams/{id}.leaderId), never to other teams.
//
// NOTE: userRole is still self-assignable (including "admin") during internal
// testing. Lock this down before public release (see
// docs/15_store_readiness_evaluation.md, C1).
//
// Before deploying, diff against the live ruleset (docs/12_development_notes.md).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userPath(id) {
      return /databases/$(database)/documents/users/$(id);
    }

    function teamPath(id) {
      return /databases/$(database)/documents/teams/$(id);
    }

    function codePath(code) {
      return /databases/$(database)/documents/teamCodes/$(code);
    }

    function isAdmin() {
      return signedIn() &&
        exists(userPath(uid())) &&
        get(userPath(uid())).data.get('userRole', '') in ['admin', 'Admin'];
    }

    function hasLeaderRole(id) {
      return exists(userPath(id)) && (
        get(userPath(id)).data.get('userRole', '') in ['teamLeader', 'TeamLeader'] ||
        get(userPath(id)).data.get('accountType', '') == 'team_leader');
    }

    function isActiveTeamData(data) {
      return data.get('isActive', true) == true;
    }

    // Caller is a member or the leader of team `id`.
    function inTeam(id) {
      return id is string &&
        exists(teamPath(id)) &&
        (uid() in get(teamPath(id)).data.get('memberIds', []) ||
         get(teamPath(id)).data.leaderId == uid());
    }

    // Caller is the leader of team `id`.
    function leadsTeam(id) {
      return id is string &&
        exists(teamPath(id)) &&
        get(teamPath(id)).data.leaderId == uid();
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------- users ----------

    match /users/{userId} {
      // Own profile, admins, and people in the same team as this user.
      allow get: if signedIn() && (
        uid() == userId ||
        isAdmin() ||
        inTeam(resource.data.get('teamId', null))
      );
      allow list: if isAdmin();

      allow create: if signedIn() &&
        uid() == userId &&
        request.resource.data.get('userRole', 'teamMember') in
          ['teamMember', 'teamLeader', 'admin', 'TeamMember', 'TeamLeader', 'Admin'];

      allow update: if signedIn() && (
        // Owner edits their own profile.
        (uid() == userId &&
         request.resource.data.get('userRole', 'teamMember') in
           ['teamMember', 'teamLeader', 'admin', 'TeamMember', 'TeamLeader', 'Admin']) ||
        // Admin clears teamId / sets a member's specialty.
        (isAdmin() && changedKeys().hasOnly(['teamId', 'role', 'updatedAt'])) ||
        // Leader of the user's current team: clear teamId (remove member,
        // delete team) or change the member's specialty role.
        (leadsTeam(resource.data.get('teamId', null)) && (
          (changedKeys().hasOnly(['teamId', 'updatedAt']) &&
           request.resource.data.get('teamId', null) == null) ||
          changedKeys().hasOnly(['role', 'updatedAt'])))
      );

      allow delete: if signedIn() && uid() == userId;
    }

    // ---------- team invite codes ----------

    // Doc ID is the invite code; { teamId, createdAt }.
    match /teamCodes/{code} {
      // Lookup by exact code only. No listing, so codes can't be enumerated.
      allow get: if signedIn();
      allow list: if false;

      // Created with the team (same batch) or backfilled by the team's leader.
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['teamId', 'createdAt']) &&
        request.resource.data.teamId is string &&
        existsAfter(teamPath(request.resource.data.teamId)) &&
        getAfter(teamPath(request.resource.data.teamId)).data.teamCode == code &&
        getAfter(teamPath(request.resource.data.teamId)).data.leaderId == uid();

      allow update: if false;

      allow delete: if signedIn() && (
        isAdmin() || leadsTeam(resource.data.teamId)
      );
    }

    // ---------- teams ----------

    match /teams/{teamId} {
      allow get, list: if signedIn() && (
        isAdmin() ||
        uid() in resource.data.memberIds ||
        resource.data.leaderId == uid()
      );

      // The creator becomes the leader and sole member, and the invite code
      // must be reserved in /teamCodes in the same batch.
      allow create: if signedIn() &&
        request.resource.data.leaderId == uid() &&
        request.resource.data.memberIds == [uid()] &&
        request.resource.data.get('isActive', true) == true &&
        request.resource.data.teamCode is string &&
        existsAfter(codePath(request.resource.data.teamCode)) &&
        getAfter(codePath(request.resource.data.teamCode)).data.teamId == teamId;

      allow update: if signedIn() && (
        // Leader edits their active team (name, description, close, remove
        // members). Can't change leaderId/teamCode or add members directly.
        (resource.data.leaderId == uid() &&
         isActiveTeamData(resource.data) &&
         !changedKeys().hasAny(['leaderId', 'teamCode']) &&
         request.resource.data.memberIds.toSet()
           .difference(resource.data.memberIds.toSet()).size() == 0) ||

        // Admin edits any active team (same immutables).
        (isAdmin() &&
         isActiveTeamData(resource.data) &&
         !changedKeys().hasAny(['leaderId', 'teamCode'])) ||

        // Leadership transfer to an existing member with the Team Leader role.
        (resource.data.leaderId == uid() &&
         isActiveTeamData(resource.data) &&
         changedKeys().hasOnly(['leaderId', 'updatedAt']) &&
         request.resource.data.leaderId in resource.data.memberIds &&
         hasLeaderRole(request.resource.data.leaderId)) ||

        // Join: the caller adds only themselves and proves the invite code
        // via users/{uid}.joinCode written in the same transaction.
        (isActiveTeamData(resource.data) &&
         changedKeys().hasOnly(['memberIds', 'updatedAt']) &&
         !(uid() in resource.data.memberIds) &&
         request.resource.data.memberIds.toSet() ==
           resource.data.memberIds.toSet().union([uid()].toSet()) &&
         request.resource.data.memberIds.size() <= 50 &&
         existsAfter(userPath(uid())) &&
         getAfter(userPath(uid())).data.get('joinCode', '') == resource.data.teamCode) ||

        // Leave (Leave Team / Delete Account): a non-leader member removes
        // only themselves.
        (uid() in resource.data.memberIds &&
         uid() != resource.data.leaderId &&
         changedKeys().hasOnly(['memberIds', 'updatedAt']) &&
         !(uid() in request.resource.data.memberIds) &&
         request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1) ||

        // Task bookkeeping on an active team by its members or an admin.
        (isActiveTeamData(resource.data) &&
         changedKeys().hasOnly(['taskIds', 'updatedAt']) &&
         (uid() in resource.data.memberIds ||
          uid() == resource.data.leaderId ||
          isAdmin()))
      );

      allow delete: if signedIn() && (
        resource.data.leaderId == uid() || isAdmin()
      );
    }

    // ---------- tasks ----------

    match /tasks/{taskId} {
      allow get, list: if signedIn() && (
        isAdmin() ||
        resource.data.createdBy == uid() ||
        resource.data.assignedTo == uid() ||
        inTeam(resource.data.teamId)
      );

      // Members/leaders create tasks in their own active team; admins anywhere.
      allow create: if signedIn() &&
        request.resource.data.createdBy == uid() &&
        request.resource.data.teamId is string &&
        (isAdmin() ||
         (inTeam(request.resource.data.teamId) &&
          isActiveTeamData(get(teamPath(request.resource.data.teamId)).data)));

      // Creator, assignee, or the leader of the task's team, while they are in
      // that team. The task can't move teams, and createdBy only changes when
      // the creator anonymizes it during account deletion.
      allow update: if signedIn() && (
        isAdmin() ||
        // Account deletion anonymizes the user's tasks, including tasks in
        // teams they've since left. Only the identifying fields may change,
        // each only from the caller's uid to the marker. Covers a task the
        // caller both created and self-assigned (one write, both fields).
        (changedKeys().hasOnly(['createdBy', 'assignedTo']) &&
         (resource.data.createdBy == uid() ||
          resource.data.get('assignedTo', null) == uid()) &&
         (request.resource.data.createdBy == resource.data.createdBy ||
          (resource.data.createdBy == uid() &&
           request.resource.data.createdBy == 'deleted_user')) &&
         (request.resource.data.get('assignedTo', null) ==
            resource.data.get('assignedTo', null) ||
          (resource.data.get('assignedTo', null) == uid() &&
           request.resource.data.assignedTo == 'deleted_user'))) || (
          inTeam(resource.data.teamId) &&
          (resource.data.createdBy == uid() ||
           resource.data.get('assignedTo', null) == uid() ||
           leadsTeam(resource.data.teamId)) &&
          request.resource.data.teamId == resource.data.teamId &&
          (request.resource.data.createdBy == resource.data.createdBy ||
           (resource.data.createdBy == uid() &&
            request.resource.data.createdBy == 'deleted_user'))
        )
      );

      allow delete: if signedIn() && (
        isAdmin() ||
        leadsTeam(resource.data.teamId) ||
        (resource.data.createdBy == uid() && inTeam(resource.data.teamId))
      );
    }

    // ---------- offline map snapshots ----------

    // One document per user (keyed by uid), written by
    // FirebaseMapSnapshotSource after each offline region refresh.
    match /mapSnapshots/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }
  }
}
