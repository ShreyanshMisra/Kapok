# Node / Firebase
firebase-debug.log
firebase/.firebaserc
firebase/.firebase/
firebase/functions/node_modules/
firebase/functions/lib/
firebase/functions/.env

# Environment files
.env
*.env
*.key
*.pem
*.json

# Firebase mobile config (re-downloaded from Firebase Console per developer;
# google-services.json is also caught by *.json above)
app/ios/Runner/GoogleService-Info.plist
app/android/app/google-services.json

# Android signing keys
app/android/key.properties
app/android/**/*.jks
app/android/**/*.keystore

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude

# Build and logs
logs/
*.log
*.tmp

# Python / scripts (if added later)
__pycache__/
*.pyc

# Local tooling
scripts/tmp/
notes/